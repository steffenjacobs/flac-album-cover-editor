# Copy this file to ".env" and adjust the values, then run:  docker compose up
#
# --- SMB / CIFS share holding your music -------------------------------------
# Your library is \\192.168.1.147\Music\Music HQ, i.e.:
#   share  = Music   (mounted into the container at /music)
#   subdir = Music HQ (the folder inside the share that gets scanned)
SMB_HOST=192.168.1.147
SMB_SHARE=Music
MUSIC_SUBDIR=Music HQ

# --- Credentials for the share ----------------------------------------------
# For an anonymous/guest share, leave SMB_USER=guest and SMB_PASSWORD empty.
# NOTE: the password must not contain a comma (CIFS options are comma-separated).
SMB_USER=guest
SMB_PASSWORD=

# SMB protocol version. 3.0 suits modern Windows/NAS; try 2.1 or 1.0 if the
# mount fails with "host is down" / permission errors.
SMB_VERS=3.0

# --- App settings ------------------------------------------------------------
# Minimum acceptable cover dimension in pixels.
MIN_SIZE=800

# Parallel file readers during a scan (hides SMB latency). 8 is a safe default;
# raise on a fast wired LAN, lower on Wi-Fi/VPN/signed shares.
SCAN_WORKERS=8
